export default async function handler(request) {
  const url = new URL(request.url);
  const q = url.searchParams.get("q")?.trim();

  if (!q) {
    return Response.json(
      { error: "Search query is required" },
      { status: 400 }
    );
  }

  const products = [
    {
      id: "demo-1",
      title: "Wireless Noise-Cancel Headphones",
      price: 1999,
      oldPrice: 2999,
      source: "Demo Store",
      rating: 4.5,
      reviews: 1200,
      thumbnail: "",
      link: "#",
      delivery: "Demo data"
    },
    {
      id: "demo-2",
      title: "Smart Fitness Watch",
      price: 1499,
      oldPrice: 2199,
      source: "Demo Store",
      rating: 4.3,
      reviews: 800,
      thumbnail: "",
      link: "#",
      delivery: "Demo data"
    }
  ];

  return Response.json({
    mode: "demo",
    query: q,
    products
  });
}
